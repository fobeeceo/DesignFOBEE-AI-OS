# Database (Supabase Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/designfobee"
DIRECT_URL="postgresql://postgres:password@localhost:5432/designfobee"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# 네이버 로그인 (Supabase 미지원 → 자체 구현, https://developers.naver.com 에서 발급)
NAVER_CLIENT_ID="your-naver-client-id"
NAVER_CLIENT_SECRET="your-naver-client-secret"

# Site
NEXT_PUBLIC_SITE_URL="https://designfobee.com"

# Gemini (STEP 4+5 AI 인테리어 이미지 생성)
GEMINI_API_KEY="발급받은_Gemini_API_Key"

# n8n 자동화 엔진이 /api/hq/* 를 호출할 때 쓰는 서비스 토큰(브라우저 로그인 세션 대체).
# 비워두면 서비스 토큰 인증 경로 자체가 비활성화되고 기존 관리자 로그인만 동작(무파괴).
# 값을 정하면 AI-HQ/docker-compose.yml의 n8n 서비스에도 N8N_SERVICE_TOKEN으로 동일하게 넣는다.
N8N_SERVICE_TOKEN=""

# n8n REST/공개 API(workflow 생성·조회 등)를 호출할 때 쓰는 n8n 자체 API 키.
# n8n UI(Settings → API)에서 발급하며, Claude Code가 워크플로를 자동 등록할 때만 사용한다.
N8N_API_KEY=""

# 상담 리드 이메일 알림 (문의 유실 방지 이중 안전장치)
# RESEND_API_KEY 미설정 시 알림만 비활성화되고 나머지 동작은 그대로다.
RESEND_API_KEY=""                                   # https://resend.com → API Keys (re_로 시작)
LEAD_NOTIFY_TO="ceo@fobee.co.kr"                    # 쉼표로 여러 명 지정 가능
LEAD_NOTIFY_FROM="DesignFOBEE <onboarding@resend.dev>"  # 도메인 인증 후 noreply@fobee.co.kr 로 변경

# 헤르메스(전령) 전달 채널 — 값이 없으면 해당 채널이 "미연동"으로 판정될 뿐 동작은 깨지지 않는다.
# 채널을 켜는 것은 외부 서비스 연결이므로 CEO 승인 대상이다(CEO-CHARTER §16-B).
DISCORD_WEBHOOK_URL=""      # Discord 채널 → 연동 → 웹후크
NOTION_API_KEY=""           # Notion Internal Integration (AI 제안함 DB 접근)
TELEGRAM_BOT_TOKEN=""       # @BotFather 발급 (TODO.md — Bot 미생성 상태)
