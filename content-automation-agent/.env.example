# AI Media Automation OS — 환경변수 템플릿
# 실제 값은 .env 에 넣는다 (.env 는 절대 커밋 금지). 코드에 키를 직접 쓰지 않는다.

# --- LLM ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- 업로드 플랫폼 (OAuth/토큰) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
META_GRAPH_ACCESS_TOKEN=        # Instagram/Facebook/Threads
META_IG_BUSINESS_ID=
TIKTOK_ACCESS_TOKEN=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_BLOGGER_API_KEY=
GOOGLE_BLOGGER_BLOG_ID=

# --- 미디어 생성 ---
TTS_API_KEY=                    # Voice Producer
VIDEO_API_KEY=                  # Video 생성/렌더

# --- 데이터 (SSOT) ---
NOTION_API_KEY=                 # Master DB / Living Document 환류
NOTION_MASTER_DB_ID=fb9143dc7e9946af8da0926e143d4561
NOTION_CHANGE_REPORT_DB_ID=c3354f52a2ce4841bcb1aa58aef7527a

# --- 가드레일 기본값 ---
DEFAULT_VISIBILITY=private       # private | scheduled | public
DRY_RUN=true                     # true면 실제 업로드 안 하고 로그만
