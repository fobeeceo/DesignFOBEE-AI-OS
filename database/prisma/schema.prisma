// DesignFOBEE-AI Sales OS — Prisma Schema
// STEP 1: Lead. STEP 2: Profile. STEP 3: Project/SpacePhoto(사진 업로드).
// STEP 4~5: DesignImage(AI 생성 결과)/DesignGeneration(사용량 로그).
// STEP 6: DesignImage.description(AI 설명 생성).
// STEP 7: Estimate(AI 예상 견적).
// STEP 8: Lead.designImageId(AI 디자인 결과를 첨부한 상담 신청).
// STEP 9: Profile.isAdmin(관리자 구분) / LeadNote(상담 이력 CRM 저장).
// 이후 STEP에서 확장.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

/// STEP 11: AI가 예상투자금·창업시기·점포보유여부로 자동 계산하는 상담 우선순위.
enum LeadPriority {
  HIGH
  MEDIUM
  LOW
}

enum AuthProvider {
  EMAIL
  GOOGLE
  KAKAO
  NAVER
}

enum ProjectStatus {
  UPLOADED
  ANALYZING
  ANALYZED
  DESIGNED
  ESTIMATED
  CONSULTED
}

/// 홈페이지 상담 신청 (STEP 1) → STEP 9 CRM의 기반 테이블.
/// 로그인 사용자가 신청한 경우 profile과 연결된다 (STEP 2 이후).
/// STEP 8: AI 디자인 스튜디오에서 신청한 경우 designImage와 연결된다.
/// STEP 9: notes로 상담원이 남긴 상담 이력을 조회할 수 있다.
/// STEP 10: /franchise 가맹상담 전용 필드(전부 nullable) — 다른 source의 리드에는 값이 없다.
model Lead {
  id                  String       @id @default(cuid())
  name                String
  phone               String
  email               String?
  message             String?
  source              String       @default("homepage")
  status              LeadStatus   @default(NEW)
  profileId           String?
  profile             Profile?     @relation(fields: [profileId], references: [id])
  designImageId       String?
  designImage         DesignImage? @relation(fields: [designImageId], references: [id])
  notes               LeadNote[]
  preferredRegion     String?
  plannedTiming       String?
  expectedInvestment  String?
  currentOccupation   String?
  hasStorefront       Boolean?
  consultationPurpose String?
  privacyConsent      Boolean      @default(false)

  /// 공간 상담(/consult)에서 받은 도면 파일의 Storage 경로.
  /// ⚠️ 공개 URL이 아니라 비공개 버킷의 "경로"만 저장한다. 열람은 서명 링크로만 한다.
  ///    DB가 유출되어도 경로만으로는 파일을 열 수 없어야 하기 때문이다.
  attachments         String[]     @default([])

  /// STEP 11 (Franchise AI v2.0) — AI 진단 결과. 저장 시 서버에서 자동 계산한다.
  /// 접수번호(GBR-YYYYMMDD-NNNN)는 관리자가 전화 상담 중 바로 검색하는 키다.
  referenceNo         String?       @unique
  fitScore            Int?
  priority            LeadPriority?
  tags                String[]      @default([])
  recommendedCases    String[]      @default([])
  /// 관리자가 상담 후 직접 기록하는 영역(AI 초안 → 사람이 보정).
  aiSummary           String?
  nextAction          String?
  aiMemo              String?

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // CEO Dashboard 집계(월별·지역별·우선순위별·경로별) 조회를 위한 인덱스.
  @@index([createdAt])
  @@index([source])
  @@index([priority])
  @@index([preferredRegion])
  @@map("leads")
}

/// STEP 2: 회원가입 사용자 프로필.
/// id는 Supabase auth.users.id(uuid)와 1:1로 동일한 값을 사용한다.
/// (auth.users는 Supabase가 관리하므로 Prisma로 직접 매핑하지 않고 id만 공유)
/// STEP 9: isAdmin으로 관리자(CRM/관리자 페이지 접근 가능) 여부를 구분한다.
/// ⚠️ 기본값은 false — 실제 배포 시 관리자 계정은 DB에서 직접 true로 전환해야 한다.
model Profile {
  id          String             @id
  name        String
  phone       String?
  provider    AuthProvider       @default(EMAIL)
  isAdmin     Boolean            @default(false)
  leads       Lead[]
  projects    Project[]
  generations DesignGeneration[]
  leadNotes   LeadNote[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("profiles")
}

/// STEP 3: 사진 업로드 세션 단위. STEP 4(AI 공간분석)부터 STEP 8(상담신청)까지
/// 이 Project를 기준으로 결과가 누적된다.
model Project {
  id           String        @id @default(cuid())
  profileId    String
  profile      Profile       @relation(fields: [profileId], references: [id])
  title        String?
  status       ProjectStatus @default(UPLOADED)
  photos       SpacePhoto[]
  designImages DesignImage[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("projects")
}

/// STEP 3: 업로드된 공간 사진. storagePath는 Supabase Storage 내 경로.
model SpacePhoto {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id])
  storagePath  String
  url          String
  originalName String
  mimeType     String
  sizeBytes    Int
  designImages DesignImage[]
  createdAt    DateTime      @default(now())

  @@map("space_photos")
}

/// STEP 4+5: 사용자가 선택한 공간 유형·스타일로 Gemini가 생성한 리디자인 결과 이미지.
/// STEP 6: description에 AI가 생성한 설명 문구를 저장한다.
/// STEP 8: leads로 이 결과를 첨부한 상담 신청들을 역참조한다.
model DesignImage {
  id            String     @id @default(cuid())
  projectId     String
  project       Project    @relation(fields: [projectId], references: [id])
  sourcePhotoId String
  sourcePhoto   SpacePhoto @relation(fields: [sourcePhotoId], references: [id])
  roomType      String
  style         String
  storagePath   String
  url           String
  description   String?
  estimate      Estimate?
  leads         Lead[]
  createdAt     DateTime   @default(now())

  @@map("design_images")
}

/// STEP 4+5: 로그인 사용자별 AI 생성 사용량 로그 (무료 횟수 제한에 사용).
model DesignGeneration {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  createdAt DateTime @default(now())

  @@map("design_generations")
}

/// 공개 AI 스튜디오(/design, 로그인 없음) 실사용 로그. DesignGeneration과 별개다 —
/// /design은 Profile 없이 익명으로 쓰이는 실제 고객 화면이라 여기에만 기록이 남는다.
/// byok=true(고객 본인 API 키)는 우리 Gemini 비용에 잡히지 않으므로 집계 시 제외한다.
model PublicGeneration {
  id        String   @id @default(cuid())
  /// "generate"(최초 생성) | "refine"(대화형 리파인)
  source    String
  byok      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("public_generations")
}

/// STEP 7: AI 예상 견적. 임시 단가(prompts/pricing.ts) 기준으로 계산된
/// 참고용 범위이며, 실제 견적은 현장 실측 후 확정된다.
model Estimate {
  id            String      @id @default(cuid())
  designImageId String      @unique
  designImage   DesignImage @relation(fields: [designImageId], references: [id])
  areaSqm       Float
  pricePerSqm   Int
  minPrice      Int
  maxPrice      Int
  createdAt     DateTime    @default(now())

  @@map("estimates")
}

/// STEP 9: CRM 저장 — 상담원이 리드에 남기는 메모/통화 이력.
/// 이 테이블이 쌓일수록 고객 상담 히스토리가 데이터 자산으로 축적된다.
model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  authorId  String?
  author    Profile? @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@map("lead_notes")
}

// ── AI Search 노출 진단 시스템 (Phase 5) ─────────────────────────────────
// 마이그레이션 실행 전 대표 승인 필요 (§0-2 원칙 6)

/// AI 검색 진단 대상 사업체.
/// 초기값은 lib/ai-search/constants.ts의 DEMO_BUSINESSES에서 seed.
model AiSearchBusiness {
  id             String   @id @default(cuid())
  name           String
  businessType   String
  brand          String
  address        String?
  phone          String?
  businessHours  String?
  websiteUrl     String?
  naverPlaceUrl  String?
  googlePlaceUrl String?
  instagramUrl   String?
  menuOrServices String?
  priceRange     String?
  /// PENDING | CONFIRMED | NEEDS_UPDATE
  factCheckStatus String  @default("PENDING")
  factCheckedAt  String?
  factCheckedBy  String?
  isActive       Boolean  @default(true)
  notes          String?
  runs           AiSearchRun[]
  questions      AiSearchQuestionSnapshot[]
  improvementTasks AiImprovementTask[]
  contentDrafts  AiContentDraft[]
  monthlyReports AiMonthlyReport[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("ai_search_businesses")
}

/// AI 검색 진단 질문 스냅샷 — 질문 변경 이력 추적.
model AiSearchQuestionSnapshot {
  id           String   @id @default(cuid())
  businessId   String
  business     AiSearchBusiness @relation(fields: [businessId], references: [id])
  questionCode String
  questionText String
  /// BRAND | LOCATION | MENU | PRICE | ATMOSPHERE | FRANCHISE | REVIEW | COMPARISON | RECOMMEND | OTHER
  category     String
  region       String?
  searchIntent String
  isActive     Boolean  @default(true)
  version      Int      @default(1)
  versionNote  String?
  results      AiSearchResult[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([businessId, questionCode, version])
  @@index([businessId])
  @@map("ai_search_question_snapshots")
}

/// 측정 실행(1 run = 최대 20문항) 기록.
/// runId UNIQUE 제약으로 중복 실행 방지.
model AiSearchRun {
  id             String   @id @default(cuid())
  runId          String   @unique
  businessId     String
  business       AiSearchBusiness @relation(fields: [businessId], references: [id])
  /// GEMINI | CHATGPT
  aiService      String
  aiModel        String
  /// RUNNING | COMPLETED | FAILED | PARTIAL
  status         String   @default("RUNNING")
  totalQuestions Int
  mentioned      Int      @default(0)
  notMentioned   Int      @default(0)
  failed         Int      @default(0)
  /// 성공 분모 기준 언급률 — FAILED/UNMEASURED 제외 (핵심 규칙)
  mentionRate    Float?
  /// SCHEDULE | MANUAL
  triggeredBy    String   @default("MANUAL")
  timeoutMs      Int      @default(30000)
  startedAt      DateTime
  finishedAt     DateTime?
  results        AiSearchResult[]
  createdAt      DateTime @default(now())

  @@index([businessId, startedAt])
  @@map("ai_search_runs")
}

/// 질문 1개의 측정 결과.
/// FAILED ≠ NOT_MENTIONED — failureReason 있으면 반드시 FAILED로 저장.
model AiSearchResult {
  id            String   @id @default(cuid())
  runId_fk      String
  run           AiSearchRun @relation(fields: [runId_fk], references: [id])
  questionId    String
  question      AiSearchQuestionSnapshot @relation(fields: [questionId], references: [id])
  questionCode  String
  /// MENTIONED | NOT_MENTIONED | FAILED | UNMEASURED
  mentionStatus String
  answerSummary String?  @db.Text
  sourceUrls    String[] @default([])
  evidence      String?  @db.Text
  failureReason String?
  measuredAt    DateTime
  createdAt     DateTime @default(now())

  @@index([runId_fk])
  @@index([questionCode])
  @@map("ai_search_results")
}

/// 개선 과제.
model AiImprovementTask {
  id                   String   @id @default(cuid())
  businessId           String
  business             AiSearchBusiness @relation(fields: [businessId], references: [id])
  questionCode         String
  relatedQuestionCodes String[] @default([])
  problem              String   @db.Text
  hypothesis           String   @db.Text
  contentPlan          String   @db.Text
  targetPlatform       String
  /// PENDING | PLANNING | AWAITING_CEO | AWAITING_CUSTOMER | IN_PROGRESS | DONE | VERIFIED
  status               String   @default("PENDING")
  /// AI | CEO | CUSTOMER
  assignee             String   @default("AI")
  customerApproved     Boolean?
  executedAt           DateTime?
  /// IMPROVED | NO_CHANGE | REGRESSION | INSUFFICIENT_DATA
  verificationResult   String?
  verifiedAt           DateTime?
  contentDrafts        AiContentDraft[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([businessId])
  @@map("ai_improvement_tasks")
}

/// 콘텐츠 초안.
/// canPublish() = status='APPROVED' AND factChecked=true (§0-2 원칙 2·3).
model AiContentDraft {
  id                 String   @id @default(cuid())
  businessId         String
  business           AiSearchBusiness @relation(fields: [businessId], references: [id])
  improvementTaskId  String
  improvementTask    AiImprovementTask @relation(fields: [improvementTaskId], references: [id])
  targetQuestionCode String
  /// NAVER_BLOG | GOOGLE_BUSINESS | INSTAGRAM | THREADS | FACEBOOK | TIKTOK | YOUTUBE_SHORTS
  platform           String
  title              String
  body               String   @db.Text
  keywords           String[] @default([])
  /// DRAFT | AWAITING_CEO | CEO_APPROVED | AWAITING_CUSTOMER | APPROVED | PUBLISHED | REJECTED
  status             String   @default("DRAFT")
  ceoFeedback        String?  @db.Text
  customerFeedback   String?  @db.Text
  /// 반드시 사람이 확인 후 true로 전환 — AI가 자동으로 true 설정 금지
  factChecked        Boolean  @default(false)
  factCheckItems     String[] @default([])
  publishedAt        DateTime?
  publishedUrl       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([businessId])
  @@map("ai_content_drafts")
}

/// 월간 AI 검색 노출 리포트.
/// approvedByCeo=false이면 대외 공유 불가 (§0-2 원칙 3·6).
model AiMonthlyReport {
  id                 String   @id @default(cuid())
  businessId         String
  business           AiSearchBusiness @relation(fields: [businessId], references: [id])
  /// YYYY-MM 형식
  reportMonth        String
  executiveSummary   String   @db.Text
  /// DashboardStats JSON (overall/general/brand/measuredAt/model)
  statsSnapshot      Json
  /// ComparisonSummary JSON — null이면 전월 데이터 없음
  comparisonSnapshot Json?
  measurementRunIds  String[] @default([])
  approvedByCeo      Boolean  @default(false)
  approvedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([businessId, reportMonth])
  @@index([businessId])
  @@map("ai_monthly_reports")
}

// ============================================================
// GBRICK COFFEE APP — FRANCHISE MANAGEMENT PLATFORM v1.0
// 모든 모델: Gb 접두어 / 모든 테이블: gb_ 접두어
// DesignFOBEE 기존 16개 모델과 완전 독립 설계
// CEO 전권 위임 명령서 v1.0 기준 구현
// ============================================================

// ─── GBRICK ENUMS ────────────────────────────────────────────

enum GbStoreStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum GbStoreUserRole {
  HQ_SUPER_ADMIN
  HQ_ADMIN
  HQ_MANAGER
  STORE_OWNER
  STORE_MANAGER
  STORE_STAFF
}

enum GbOrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  PICKED_UP
  CANCELLED
  REFUNDED
}

enum GbPaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  PARTIAL_REFUNDED
}

enum GbPaymentMethod {
  MOCK
  CARD
  KAKAO_PAY
  NAVER_PAY
  TOSS
}

enum GbPointLedgerType {
  EARN
  REDEEM
  EXPIRE
  REFUND
  ADJUSTMENT
  REVERSAL
}

enum GbCouponType {
  DISCOUNT_AMOUNT
  DISCOUNT_RATE
  FREE_ITEM
  FREE_UPGRADE
}

enum GbCouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum GbStampLedgerType {
  EARN
  REDEEM
  EXPIRE
  ADJUSTMENT
  REVERSAL
}

enum GbNotificationChannel {
  PUSH
  SMS
  EMAIL
  KAKAO_ALIM
}

enum GbCampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

enum GbChecklistCategory {
  OPENING
  CLOSING
  CLEANING
  SAFETY
  INVENTORY
  CUSTOM
}

enum GbInquiryStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ─── STORE & USERS ───────────────────────────────────────────

model GbStore {
  id                String          @id @default(cuid())
  code              String          @unique
  name              String
  brandName         String          @default("GBRICK Coffee")
  status            GbStoreStatus   @default(PENDING)
  phone             String?
  address           String
  addressDetail     String?
  lat               Float?
  lng               Float?
  timezone          String          @default("Asia/Seoul")
  businessNumber    String?
  ownerName         String?
  openedAt          DateTime?
  closedAt          DateTime?
  pointRate         Float           @default(0.03)
  stampPerOrder     Int             @default(1)
  stampGoal         Int             @default(10)
  operatingHours    Json?
  imageUrl          String?
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  storeUsers        GbStoreUser[]
  orders            GbOrder[]
  menuAvailability  GbStoreMenuAvailability[]
  checklists        GbChecklist[]
  notices           GbStoreNotice[]
  inquiries         GbStoreInquiry[]
  maintenanceReqs   GbMaintenanceRequest[]
  campaignTargets   GbCampaignTarget[]
  favoriteCustomers GbCustomer[]    @relation("GbCustomerFavoriteStore")
  auditLogs         GbAuditLog[]

  @@index([status])
  @@map("gb_stores")
}

model GbStoreUser {
  id          String          @id
  storeId     String
  store       GbStore         @relation(fields: [storeId], references: [id])
  role        GbStoreUserRole
  displayName String
  email       String
  phone       String?
  isActive    Boolean         @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([storeId, id])
  @@index([storeId, role])
  @@map("gb_store_users")
}

// ─── CUSTOMER ────────────────────────────────────────────────

model GbCustomer {
  id              String     @id
  nickname        String?
  phone           String?
  email           String?
  birthdate       String?
  favoriteStoreId String?
  favoriteStore   GbStore?   @relation("GbCustomerFavoriteStore", fields: [favoriteStoreId], references: [id])
  marketingAgree  Boolean    @default(false)
  pushAgree       Boolean    @default(false)
  isActive        Boolean    @default(true)
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  orders         GbOrder[]
  pointAccount   GbPointAccount?
  stampAccounts  GbStampAccount[]
  couponIssues   GbCouponIssue[]
  consents       GbCustomerConsent[]
  notifications  GbNotificationLog[]

  @@index([phone])
  @@index([email])
  @@map("gb_customers")
}

model GbCustomerConsent {
  id           String     @id @default(cuid())
  customerId   String
  customer     GbCustomer @relation(fields: [customerId], references: [id])
  consentType  String
  agreed       Boolean
  agreedAt     DateTime
  ipAddress    String?
  createdAt    DateTime   @default(now())

  @@index([customerId])
  @@map("gb_customer_consents")
}

// ─── MENU ────────────────────────────────────────────────────

model GbMenuCategory {
  id          String   @id @default(cuid())
  name        String
  nameEn      String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menus       GbMenu[]

  @@index([sortOrder])
  @@map("gb_menu_categories")
}

model GbMenu {
  id              String         @id @default(cuid())
  categoryId      String
  category        GbMenuCategory @relation(fields: [categoryId], references: [id])
  name            String
  nameEn          String?
  description     String?        @db.Text
  basePrice       Int
  imageUrl        String?
  isSignature     Boolean        @default(false)
  isNew           Boolean        @default(false)
  isSoldOut       Boolean        @default(false)
  isActive        Boolean        @default(true)
  calories        Int?
  allergens       String[]       @default([])
  tags            String[]       @default([])
  sortOrder       Int            @default(0)
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  options           GbMenuOption[]
  storeAvailability GbStoreMenuAvailability[]
  orderItems        GbOrderItem[]
  priceHistory      GbMenuPriceHistory[]
  recipeVersions    GbRecipeVersion[]

  @@index([categoryId, isActive])
  @@index([isActive, sortOrder])
  @@map("gb_menus")
}

model GbMenuOption {
  id           String   @id @default(cuid())
  menuId       String
  menu         GbMenu   @relation(fields: [menuId], references: [id])
  name         String
  extraPrice   Int      @default(0)
  isDefault    Boolean  @default(false)
  isRequired   Boolean  @default(false)
  groupName    String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orderItemOptions GbOrderItemOption[]

  @@index([menuId])
  @@map("gb_menu_options")
}

model GbStoreMenuAvailability {
  id          String   @id @default(cuid())
  storeId     String
  store       GbStore  @relation(fields: [storeId], references: [id])
  menuId      String
  menu        GbMenu   @relation(fields: [menuId], references: [id])
  isSoldOut   Boolean  @default(false)
  price       Int?
  updatedAt   DateTime @updatedAt

  @@unique([storeId, menuId])
  @@map("gb_store_menu_availability")
}

model GbMenuPriceHistory {
  id          String   @id @default(cuid())
  menuId      String
  menu        GbMenu   @relation(fields: [menuId], references: [id])
  price       Int
  changedBy   String
  reason      String?
  effectiveAt DateTime
  createdAt   DateTime @default(now())

  @@index([menuId, effectiveAt])
  @@map("gb_menu_price_history")
}

model GbRecipeVersion {
  id          String   @id @default(cuid())
  menuId      String
  menu        GbMenu   @relation(fields: [menuId], references: [id])
  version     Int
  content     String   @db.Text
  changedBy   String
  notes       String?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([menuId, isActive])
  @@map("gb_recipe_versions")
}

// ─── ORDER ───────────────────────────────────────────────────

model GbOrder {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  storeId         String
  store           GbStore       @relation(fields: [storeId], references: [id])
  customerId      String?
  customer        GbCustomer?   @relation(fields: [customerId], references: [id])
  status          GbOrderStatus @default(PENDING)
  totalAmount     Int
  discountAmount  Int           @default(0)
  finalAmount     Int
  pointEarned     Int           @default(0)
  pointUsed       Int           @default(0)
  couponId        String?
  couponDiscount  Int           @default(0)
  pickupName      String?
  note            String?
  isGuest         Boolean       @default(false)
  guestName       String?
  guestPhone      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           GbOrderItem[]
  statusHistory   GbOrderStatusHistory[]
  payment         GbPayment?
  pointLedgers    GbPointLedger[]
  stampLedgers    GbStampLedger[]

  @@index([storeId, status])
  @@index([customerId])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("gb_orders")
}

model GbOrderItem {
  id          String      @id @default(cuid())
  orderId     String
  order       GbOrder     @relation(fields: [orderId], references: [id])
  menuId      String
  menu        GbMenu      @relation(fields: [menuId], references: [id])
  menuName    String
  quantity    Int
  unitPrice   Int
  totalPrice  Int
  createdAt   DateTime    @default(now())

  options     GbOrderItemOption[]

  @@index([orderId])
  @@map("gb_order_items")
}

model GbOrderItemOption {
  id              String       @id @default(cuid())
  orderItemId     String
  orderItem       GbOrderItem  @relation(fields: [orderItemId], references: [id])
  menuOptionId    String
  menuOption      GbMenuOption @relation(fields: [menuOptionId], references: [id])
  optionName      String
  extraPrice      Int          @default(0)
  createdAt       DateTime     @default(now())

  @@index([orderItemId])
  @@map("gb_order_item_options")
}

model GbOrderStatusHistory {
  id          String        @id @default(cuid())
  orderId     String
  order       GbOrder       @relation(fields: [orderId], references: [id])
  status      GbOrderStatus
  changedBy   String
  note        String?
  createdAt   DateTime      @default(now())

  @@index([orderId, createdAt])
  @@map("gb_order_status_history")
}

// ─── PAYMENT ─────────────────────────────────────────────────

model GbPayment {
  id              String           @id @default(cuid())
  orderId         String           @unique
  order           GbOrder          @relation(fields: [orderId], references: [id])
  method          GbPaymentMethod  @default(MOCK)
  status          GbPaymentStatus  @default(PENDING)
  amount          Int
  pgProvider      String?
  pgTransactionId String?
  pgPayload       Json?
  paidAt          DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  transactions    GbPaymentTransaction[]
  refunds         GbRefund[]

  @@index([status])
  @@index([pgTransactionId])
  @@map("gb_payments")
}

model GbPaymentTransaction {
  id          String    @id @default(cuid())
  paymentId   String
  payment     GbPayment @relation(fields: [paymentId], references: [id])
  type        String
  amount      Int
  pgResponse  Json?
  createdAt   DateTime  @default(now())

  @@index([paymentId])
  @@map("gb_payment_transactions")
}

model GbRefund {
  id          String    @id @default(cuid())
  paymentId   String
  payment     GbPayment @relation(fields: [paymentId], references: [id])
  amount      Int
  reason      String
  requestedBy String
  pgRefundId  String?
  pgPayload   Json?
  refundedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([paymentId])
  @@map("gb_refunds")
}

model GbPaymentWebhookEvent {
  id              String    @id @default(cuid())
  pgProvider      String
  eventType       String
  externalEventId String    @unique
  payload         Json
  processedAt     DateTime?
  error           String?
  createdAt       DateTime  @default(now())

  @@index([pgProvider, eventType])
  @@map("gb_payment_webhook_events")
}

// ─── POINTS ──────────────────────────────────────────────────

model GbPointAccount {
  id          String     @id @default(cuid())
  customerId  String     @unique
  customer    GbCustomer @relation(fields: [customerId], references: [id])
  balance     Int        @default(0)
  totalEarned Int        @default(0)
  totalUsed   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  ledgers     GbPointLedger[]

  @@map("gb_point_accounts")
}

model GbPointLedger {
  id             String            @id @default(cuid())
  accountId      String
  account        GbPointAccount    @relation(fields: [accountId], references: [id])
  orderId        String?
  order          GbOrder?          @relation(fields: [orderId], references: [id])
  type           GbPointLedgerType
  amount         Int
  balanceAfter   Int
  note           String?
  expiresAt      DateTime?
  idempotencyKey String?           @unique
  createdAt      DateTime          @default(now())

  @@index([accountId, createdAt])
  @@index([orderId])
  @@map("gb_point_ledger")
}

// ─── COUPONS ─────────────────────────────────────────────────

model GbCoupon {
  id               String         @id @default(cuid())
  code             String         @unique
  name             String
  type             GbCouponType
  status           GbCouponStatus @default(ACTIVE)
  discountAmount   Int?
  discountRate     Float?
  minOrderAmount   Int?
  maxDiscount      Int?
  freeItemMenuId   String?
  totalLimit       Int?
  perCustomerLimit Int            @default(1)
  usedCount        Int            @default(0)
  validFrom        DateTime
  validUntil       DateTime
  description      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  issues           GbCouponIssue[]

  @@index([code])
  @@index([status, validUntil])
  @@map("gb_coupons")
}

model GbCouponIssue {
  id          String     @id @default(cuid())
  couponId    String
  coupon      GbCoupon   @relation(fields: [couponId], references: [id])
  customerId  String
  customer    GbCustomer @relation(fields: [customerId], references: [id])
  issuedAt    DateTime   @default(now())
  expiresAt   DateTime?

  redemption  GbCouponRedemption?

  @@index([customerId])
  @@index([couponId])
  @@map("gb_coupon_issues")
}

model GbCouponRedemption {
  id              String        @id @default(cuid())
  couponIssueId   String        @unique
  couponIssue     GbCouponIssue @relation(fields: [couponIssueId], references: [id])
  orderId         String
  redeemedAt      DateTime      @default(now())
  discountApplied Int

  @@index([orderId])
  @@map("gb_coupon_redemptions")
}

// ─── STAMPS ──────────────────────────────────────────────────

model GbStampAccount {
  id          String     @id @default(cuid())
  customerId  String
  customer    GbCustomer @relation(fields: [customerId], references: [id])
  storeId     String
  balance     Int        @default(0)
  totalEarned Int        @default(0)
  totalUsed   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  ledgers     GbStampLedger[]

  @@unique([customerId, storeId])
  @@index([customerId])
  @@map("gb_stamp_accounts")
}

model GbStampLedger {
  id             String            @id @default(cuid())
  accountId      String
  account        GbStampAccount    @relation(fields: [accountId], references: [id])
  orderId        String?
  order          GbOrder?          @relation(fields: [orderId], references: [id])
  type           GbStampLedgerType
  amount         Int
  balanceAfter   Int
  note           String?
  idempotencyKey String?           @unique
  createdAt      DateTime          @default(now())

  @@index([accountId, createdAt])
  @@map("gb_stamp_ledger")
}

// ─── STORE OPERATIONS ────────────────────────────────────────

model GbChecklist {
  id          String              @id @default(cuid())
  storeId     String
  store       GbStore             @relation(fields: [storeId], references: [id])
  title       String
  category    GbChecklistCategory
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  items       GbChecklistItem[]
  completions GbChecklistCompletion[]

  @@index([storeId, category])
  @@map("gb_checklists")
}

model GbChecklistItem {
  id           String      @id @default(cuid())
  checklistId  String
  checklist    GbChecklist @relation(fields: [checklistId], references: [id])
  title        String
  description  String?
  sortOrder    Int         @default(0)
  isRequired   Boolean     @default(false)
  createdAt    DateTime    @default(now())

  @@index([checklistId])
  @@map("gb_checklist_items")
}

model GbChecklistCompletion {
  id              String      @id @default(cuid())
  checklistId     String
  checklist       GbChecklist @relation(fields: [checklistId], references: [id])
  completedBy     String
  completedByName String
  itemsChecked    Json
  notes           String?
  completedAt     DateTime    @default(now())

  @@index([checklistId, completedAt])
  @@map("gb_checklist_completions")
}

model GbStoreNotice {
  id          String    @id @default(cuid())
  storeId     String?
  store       GbStore?  @relation(fields: [storeId], references: [id])
  isGlobal    Boolean   @default(false)
  title       String
  content     String    @db.Text
  isPinned    Boolean   @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([storeId, publishedAt])
  @@index([isGlobal, publishedAt])
  @@map("gb_store_notices")
}

model GbStoreInquiry {
  id          String          @id @default(cuid())
  storeId     String
  store       GbStore         @relation(fields: [storeId], references: [id])
  title       String
  content     String          @db.Text
  status      GbInquiryStatus @default(OPEN)
  createdBy   String
  assignedTo  String?
  resolvedAt  DateTime?
  response    String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([storeId, status])
  @@map("gb_store_inquiries")
}

model GbMaintenanceRequest {
  id          String          @id @default(cuid())
  storeId     String
  store       GbStore         @relation(fields: [storeId], references: [id])
  title       String
  description String          @db.Text
  priority    String          @default("NORMAL")
  status      GbInquiryStatus @default(OPEN)
  images      String[]        @default([])
  createdBy   String
  assignedTo  String?
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([storeId, status])
  @@map("gb_maintenance_requests")
}

// ─── MARKETING & NOTIFICATIONS ───────────────────────────────

model GbCampaign {
  id              String                  @id @default(cuid())
  title           String
  description     String?
  status          GbCampaignStatus        @default(DRAFT)
  channels        GbNotificationChannel[]
  targetType      String
  messageTemplate String                  @db.Text
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  createdBy       String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  targets         GbCampaignTarget[]
  notifications   GbPushNotification[]

  @@index([status])
  @@map("gb_campaigns")
}

model GbCampaignTarget {
  id          String      @id @default(cuid())
  campaignId  String
  campaign    GbCampaign  @relation(fields: [campaignId], references: [id])
  storeId     String?
  store       GbStore?    @relation(fields: [storeId], references: [id])
  customerId  String?
  createdAt   DateTime    @default(now())

  @@index([campaignId])
  @@map("gb_campaign_targets")
}

model GbPushNotification {
  id          String      @id @default(cuid())
  campaignId  String?
  campaign    GbCampaign? @relation(fields: [campaignId], references: [id])
  title       String
  body        String      @db.Text
  imageUrl    String?
  deepLink    String?
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime    @default(now())

  logs        GbNotificationLog[]

  @@index([campaignId])
  @@map("gb_push_notifications")
}

model GbNotificationLog {
  id               String                 @id @default(cuid())
  customerId       String?
  customer         GbCustomer?            @relation(fields: [customerId], references: [id])
  notificationId   String?
  notification     GbPushNotification?    @relation(fields: [notificationId], references: [id])
  channel          GbNotificationChannel
  status           String
  sentAt           DateTime?
  failReason       String?
  createdAt        DateTime               @default(now())

  @@index([customerId])
  @@index([notificationId])
  @@map("gb_notification_logs")
}

// ─── SYSTEM ──────────────────────────────────────────────────

model GbDataSyncJob {
  id          String    @id @default(cuid())
  jobType     String
  status      String
  storeId     String?
  payload     Json?
  result      Json?
  errorMsg    String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([jobType, status])
  @@map("gb_data_sync_jobs")
}

model GbAuditLog {
  id          String   @id @default(cuid())
  storeId     String?
  store       GbStore? @relation(fields: [storeId], references: [id])
  actorId     String
  actorRole   String
  action      String
  resource    String
  resourceId  String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([actorId])
  @@index([resource, resourceId])
  @@map("gb_audit_logs")
}

model GbIdempotencyKey {
  id          String   @id @default(cuid())
  key         String   @unique
  resource    String
  resourceId  String?
  response    Json?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
  @@map("gb_idempotency_keys")
}

